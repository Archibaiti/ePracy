rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ===============================================================
    // Assumed Data Model & Architecture Note
    // ===============================================================
    //
    // Architectural Note (Phase 1-3 Zero-Knowledge E2EE Mode):
    //   This app (`Private_App/src/vault_engine.js` + `Dev_Panel.html`) uses pure
    //   browser-side WebCrypto E2EE (AES-256-GCM + PBKDF2-SHA256 + RSA-OAEP-256)
    //   and communicates over the Firestore REST API without Firebase Auth sign-in.
    //   Consequently, `request.auth` is intentionally `null` until Firebase Auth
    //   and Cloud Functions are added in a later commercial phase.
    //   These rules enforce strict document paths, exact schemas, types, string/numeric
    //   bounds, and immutable fields so malformed, oversized, or schema-polluting
    //   payloads are rejected at the database boundary.
    //   Note: Because `request.auth` is `null` in this phase, `accounts` read/list/
    //   update/delete and `system_config/main` init/password-wrap updates rely on
    //   client-side E2EE confidentiality rather than Firebase Auth identity checks.
    //
    // Collection: accounts
    // Document ID: {accountId} (must match `login`: 2..64 chars, ^[a-z0-9_.-]+$)
    // Fields (exact set of 13 required/allowed fields):
    //   - login: string (required, immutable, == accountId, size 2..64, ^[a-z0-9_.-]+$)
    //   - status: string (required, in ['active', 'blocked', 'reset_pending'])
    //   - resetRequested: bool (required)
    //   - resetRequestedAt: string (required, size <= 40)
    //   - resetNote: string (required, size <= 150)
    //   - userWrappedKey: string (required, size <= 500)
    //   - resetWrappedKey: string (required, size <= 1500)
    //   - pendingResetWrappedKey: string (required, size <= 500)
    //   - pendingResetKeyB64: string (required, size <= 100)
    //   - encryptedVault: string (required, size <= 850000)
    //   - vaultBytes: int/number (required, >= 0)
    //   - createdAt: string (required, immutable, size <= 40)
    //   - updatedAt: string (required, size <= 40)
    //
    // Collection: system_config
    // Document ID: 'main' only
    // Fields (allowed set of 5 fields):
    //   - devPublicKeyJwk: string (required, immutable once initialized, size 1..2000)
    //   - wrappedDevPrivateKey: string (required, size 1..6000)
    //   - devPassInitialized: bool (required; cannot revert true -> false)
    //   - registrationMode: string (optional, in ['open', 'invite'])
    //   - createdAt: string (required, immutable once non-empty, size <= 40)
    //
    // ===============================================================

    // ===============================================================
    // Helper Functions
    // ===============================================================

    // Reserved for upcoming Firebase Auth commercial phase (`request.auth` is
    // intentionally null in current Zero-Knowledge REST mode).
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function uidUnchanged() {
      return !('uid' in request.resource.data) ||
        request.resource.data.uid == request.auth.uid;
    }

    function uidNotModified() {
      return !('uid' in request.resource.data) ||
        request.resource.data.uid == resource.data.uid;
    }

    function hasRequiredFields(fields) {
      return request.resource.data.keys().hasAll(fields);
    }

    function hasOnlyAllowedFields(fields) {
      return request.resource.data.keys().hasOnly(fields);
    }

    function validStringLength(field, minLen, maxLen) {
      return request.resource.data[field] is string &&
        request.resource.data[field].size() >= minLen &&
        request.resource.data[field].size() <= maxLen;
    }

    function areImmutableFieldsUnchanged(fields) {
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny(fields);
    }

    function isNonNegativeNumber(val) {
      return (val is int || val is number) && val >= 0;
    }

    // ===============================================================
    // Domain Validators
    // ===============================================================

    function isValidAccount(accountId, data) {
      let exactFields = [
        'login',
        'status',
        'resetRequested',
        'resetRequestedAt',
        'resetNote',
        'userWrappedKey',
        'resetWrappedKey',
        'pendingResetWrappedKey',
        'pendingResetKeyB64',
        'encryptedVault',
        'vaultBytes',
        'createdAt',
        'updatedAt'
      ];

      return hasRequiredFields(exactFields) &&
        hasOnlyAllowedFields(exactFields) &&
        validStringLength('login', 2, 64) &&
        data.login == accountId &&
        data.login.matches('^[a-z0-9_.-]+$') &&
        data.status is string &&
        data.status in ['active', 'blocked', 'reset_pending'] &&
        data.resetRequested is bool &&
        validStringLength('resetRequestedAt', 0, 40) &&
        validStringLength('resetNote', 0, 150) &&
        validStringLength('userWrappedKey', 0, 500) &&
        validStringLength('resetWrappedKey', 0, 1500) &&
        validStringLength('pendingResetWrappedKey', 0, 500) &&
        validStringLength('pendingResetKeyB64', 0, 100) &&
        validStringLength('encryptedVault', 0, 850000) &&
        isNonNegativeNumber(data.vaultBytes) &&
        validStringLength('createdAt', 0, 40) &&
        validStringLength('updatedAt', 0, 40);
    }

    function isValidSystemConfig(data) {
      let allowedFields = [
        'devPublicKeyJwk',
        'wrappedDevPrivateKey',
        'devPassInitialized',
        'registrationMode',
        'createdAt'
      ];
      let requiredFields = [
        'devPublicKeyJwk',
        'wrappedDevPrivateKey',
        'devPassInitialized',
        'createdAt'
      ];

      return hasOnlyAllowedFields(allowedFields) &&
        hasRequiredFields(requiredFields) &&
        validStringLength('devPublicKeyJwk', 1, 2000) &&
        validStringLength('wrappedDevPrivateKey', 1, 6000) &&
        data.devPassInitialized is bool &&
        (
          !('registrationMode' in data) ||
          (data.registrationMode is string && data.registrationMode in ['open', 'invite'])
        ) &&
        validStringLength('createdAt', 0, 40);
    }

    function isSystemConfigInitialized() {
      return ('devPublicKeyJwk' in resource.data) &&
        resource.data.devPublicKeyJwk is string &&
        resource.data.devPublicKeyJwk.size() > 0;
    }

    function isValidSystemConfigUpdate() {
      return (
          !isSystemConfigInitialized() ||
          resource.data.devPublicKeyJwk == request.resource.data.devPublicKeyJwk
        ) &&
        (
          !('createdAt' in resource.data) ||
          !(resource.data.createdAt is string) ||
          resource.data.createdAt.size() == 0 ||
          request.resource.data.createdAt == resource.data.createdAt
        ) &&
        (
          !('devPassInitialized' in resource.data) ||
          resource.data.devPassInitialized != true ||
          request.resource.data.devPassInitialized == true
        );
    }

    // ===============================================================
    // Collection Rules
    // ===============================================================

    // User encrypted vault accounts (REST API with `request.auth == null` in
    // current WebCrypto E2EE + Dev_Panel phase; protected by strict schema).
    match /accounts/{accountId} {
      allow get, list: if true;
      allow create: if isValidAccount(accountId, request.resource.data);
      allow update: if isValidAccount(accountId, request.resource.data) &&
        areImmutableFieldsUnchanged(['login', 'createdAt']);
      allow delete: if true;
    }

    // Singleton developer keypair & registration config (`system_config/main`).
    match /system_config/{docId} {
      allow get: if docId == 'main';
      allow list: if false;
      allow create: if docId == 'main' && isValidSystemConfig(request.resource.data);
      allow update: if docId == 'main' &&
        isValidSystemConfig(request.resource.data) &&
        isValidSystemConfigUpdate();
      allow delete: if false;
    }

    // Default deny everything else (including any nested subcollections).
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
